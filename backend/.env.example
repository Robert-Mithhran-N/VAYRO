# ==============================================================================
# VAYRO Backend API — Environment Configuration Template
# ==============================================================================
# Duplicate this file as .env in the backend/ directory for local development.
# IMPORTANT: Never commit .env or secrets to version control.
# ==============================================================================

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL & Prisma ORM Connection
DATABASE_URL=postgresql://vayro_user:vayro_secret_dev_password@localhost:5432/vayro_db

# Redis In-Memory Cache & Event Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=vayro_redis_dev_secret

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Swagger / OpenAPI
SWAGGER_ENABLED=true

# Logging Level (error, warn, log, debug, verbose)
LOG_LEVEL=debug

