# ==============================================================================
# VAYRO Mobile Client — Environment Configuration
# ==============================================================================
# Copy this file to .env or pass values via --dart-define during build/run.
#
# IMPORTANT:
# - Android Emulator uses 10.0.2.2 to reach host localhost.
# - iOS Simulator and Desktop can use 127.0.0.1 or localhost.
# - Physical devices MUST use your computer's LAN IP (e.g., 192.168.1.50).
# - NEVER embed private API keys or database credentials in the mobile client.
# ==============================================================================

VAYRO_ENV=development
VAYRO_API_BASE_URL=http://10.0.2.2:3000/api/v1
VAYRO_WS_BASE_URL=ws://10.0.2.2:3000
VAYRO_CONNECT_TIMEOUT_MS=10000
VAYRO_RECEIVE_TIMEOUT_MS=10000

