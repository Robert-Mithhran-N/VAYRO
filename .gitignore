# ==============================================================================
# VAYRO — Monorepo Git Ignore Rules
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Environment and Secrets (CRITICAL: Never commit real credentials)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Logs and Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Node / NestJS / Admin
node_modules/
dist/
build/
coverage/
.nyc_output/
.turbo/
.cache/
.vite/
*.tsbuildinfo

# Flutter and Dart
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/ephemeral/
mobile/linux/flutter/ephemeral/
mobile/windows/flutter/ephemeral/
mobile/macos/Flutter/ephemeral/
mobile/ios/Flutter/.last_build_id
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/app.flx
mobile/ios/Flutter/app.zip
mobile/ios/Flutter/flutter_assets/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/flutter_export_environment.sh
mobile/android/.gradle/
mobile/android/captures/
mobile/android/gradlew
mobile/android/gradlew.bat
mobile/android/local.properties
mobile/android/**/GeneratedPluginRegistrant.java

# Local Databases & SQLite
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
dev.db
dev.db-journal

# IDEs and Code Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Docker local data directories (if any mounted locally)
postgres_data/
redis_data/

